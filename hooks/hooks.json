{
  "description": "Bloqueia commit e push direto na main/master.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-main.sh",
            "if": "Bash(*git*)",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
