{
  "description": "Confere os hooks do git que bloqueiam commit e push na main/master e impede o Claude de desligá-los, no Bash e nas ferramentas Edit e Write sobre a configuração do git. Recusa comandos Bash que citam os padrões de produção de .fabrica/producao.txt. Atualiza a statusline da fábrica, se instalada, quando a versão do plugin muda.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/setup-statusline.sh\" --check >/dev/null 2>&1 || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-main.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-production.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/protect-main.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
